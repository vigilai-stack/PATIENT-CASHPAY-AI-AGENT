# Copy this file to .env and fill it in on the server. Never commit the filled-in file.
# Do not put a real key, a live PayPal URL, or real patient data in this demo.
# Compose sets DATABASE_URL to its own Postgres service. Leave that line out of .env.

DOMAIN=demo.example.com
SESSION_SECRET=
PAYMENT_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
FAKE_WEBHOOK_KEY=
LLM_MODE=mock

# Optional. Keep LLM_MODE=mock until a key is set in this server file only.
# A value that contains a space is ignored. /health reports openai_configured, never the key.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_SECONDS=8
# OPENAI_MAX_OUTPUT_TOKENS=120
# OPENAI_MAX_REQUESTS_PER_MINUTE=12
# OPENAI_MAX_CONCURRENCY=2
